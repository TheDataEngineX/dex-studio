# DEX Studio — Environment Variables
# Copy to .env and fill in values — never commit .env
# The app auto-loads .env from the current directory on startup.

# ── Required ──────────────────────────────────────────────────────────────────

# Session signing key (random hex string, >= 32 bytes).
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
DEX_STUDIO_SESSION_SECRET=

# ── Postgres (multi-pod mode) ─────────────────────────────────────────────────

# When set, enables PostgreSQL backend for scheduler leadership, pipeline locks,
# auth/preferences persistence. When absent, uses local SQLite (single-pod).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dex_studio

# ── Auth ──────────────────────────────────────────────────────────────────────

# Fixed password — when set, disables the /setup UI flow. If absent, a random
# password is generated on first boot (visible in startup logs).
# DEX_STUDIO_PASSPHRASE=

# ── Engine ────────────────────────────────────────────────────────────────────

# Path to a dex.yaml project config. If absent, scans ~/.dex-studio/projects/
# and bundled examples/.
# DEX_CONFIG_PATH=

# ── HTTPS / Security ──────────────────────────────────────────────────────────

# Set to 1, true, or yes to enable HTTPS-only session cookies + HSTS header.
# DEX_HTTPS=false

# Number of trusted reverse-proxy hops for client IP extraction (rate limiting).
# 0 = disable X-Forwarded-For trust (default).
# DEX_TRUSTED_PROXIES=0

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
# DEX_STUDIO_LOG_LEVEL=INFO

# Log format: "json" for structured output (containers), "console" for dev.
# Auto-detects: JSON when stdout is piped, console on TTY.
# DEX_STUDIO_LOG_FORMAT=console

# ── Alerts / Notifications ────────────────────────────────────────────────────

# Webhook URL for alert notifications (Slack, PagerDuty, etc.)
# DEX_STUDIO_ALERT_WEBHOOK_URL=

# ── OIDC Authentication (Authentik, Keycloak, etc.) ───────────────────────────

# DEX_STUDIO_OIDC_ISSUER=https://auth.example.com/application/o/dex-studio/
# DEX_STUDIO_OIDC_CLIENT_ID=dex-studio
# DEX_STUDIO_OIDC_CLIENT_SECRET=
# DEX_STUDIO_OIDC_ADMIN_GROUP=dex-studio-admins

# ── RabbitMQ (movie-dex plugins) ──────────────────────────────────────────────

# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Project Dir (movie-dex plugins) ───────────────────────────────────────────

# DEX_PROJECT_DIR=/home/dex

# ── Memory / Performance ──────────────────────────────────────────────────────

# Minimum free memory (MB) required to start a pipeline. Default 1024 (1GB).
# Can be overridden per-project in dex.yaml scheduler.min_free_mb
# DEX_MIN_FREE_MB=1024

# Maximum concurrent pipelines. Default 2.
# Can be overridden per-project in dex.yaml scheduler.max_concurrent_pipelines
# DEX_MAX_CONCURRENT_PIPELINES=2

# Embedding batch size (texts per Ollama /api/embed call). Default 16.
# Reduce to save memory (8-16 for small containers).
# DEX_EMBED_BATCH_SIZE=16

# Maximum rows to embed per collection. Default 2000.
# Reduce to limit memory (1000-2000 for small containers).
# DEX_EMBED_MAX_ROWS=2000

# Max models to keep loaded in serving engine. Default 3.
# Reduce to save memory.
# DEX_MAX_LOADED_MODELS=3

# Log buffer size (max records in memory for /system/logs UI). Default 2000.
# DEX_LOG_BUFFER_SIZE=2000

# Max conversation turns to keep in agent memory. Default 100.
# DEX_AI_MEMORY_MAX_ENTRIES=100

# ── Observability ─────────────────────────────────────────────────────────────

# OpenTelemetry collector endpoint (leave blank to disable OTLP export)
# OTLP_ENDPOINT=

# Enable console trace exporter (dev only)
# ENABLE_CONSOLE_TRACES=false